    { "displayName": "Número do BM", "name": "bmNumber", "kind": "Grouping" },
    { "displayName": "Fornecedor", "name": "supplier", "kind": "Grouping" },
    { "displayName": "Portfólio", "name": "portfolio", "kind": "Grouping" },
    { "displayName": "Status", "name": "status", "kind": "Grouping" },
    { "displayName": "Fase do projeto", "name": "projectPhase", "kind": "Grouping" },
    { "displayName": "Data de início", "name": "startDate", "kind": "Grouping" },
    { "displayName": "Data de término", "name": "endDate", "kind": "Grouping" },
    { "displayName": "Data da notificação", "name": "notificationDate", "kind": "Grouping" },
    { "displayName": "Aditivo", "name": "amendment", "kind": "Grouping" },
    { "displayName": "Data do aditivo", "name": "amendmentDate", "kind": "Grouping" },
    { "displayName": "Data de assinatura da TEC", "name": "tecSignDate", "kind": "Grouping" },
    { "displayName": "Status da TEC", "name": "tecStatus", "kind": "Grouping" },
