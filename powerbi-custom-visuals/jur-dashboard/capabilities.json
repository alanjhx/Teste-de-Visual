  "dataViewMappings": [
    {
      "table": {
        "rows": {
          "select": [
            { "for": { "in": "contract" } }, { "for": { "in": "projectId" } },
            { "for": { "in": "bmNumber" } }, { "for": { "in": "supplier" } },
            { "for": { "in": "portfolio" } }, { "for": { "in": "status" } },
            { "for": { "in": "projectPhase" } }, { "for": { "in": "startDate" } },
            { "for": { "in": "endDate" } }, { "for": { "in": "notificationDate" } },
            { "for": { "in": "amendment" } }, { "for": { "in": "amendmentDate" } },
            { "for": { "in": "tecSignDate" } }, { "for": { "in": "tecStatus" } },
            { "for": { "in": "contractValue" } }, { "for": { "in": "usedValue" } }
          ],
          "dataReductionAlgorithm": { "top": { "count": 2000 } }
        }
      }
    }
  ],
  "objects": {
    "project": {
      "displayName": "Projeto",
      "properties": {
        "projectId": { "displayName": "Código do projeto (manual)", "type": { "text": true } },
        "accentColor": { "displayName": "Cor de destaque", "type": { "fill": { "solid": { "color": true } } } }
      }
